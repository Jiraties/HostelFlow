# Local environment and secret material. Keep sanitized examples versioned.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Private keys, certificates, and provider credentials.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
credentials.json
service-account*.json
.npmrc
.pypirc
*.tfstate
*.tfstate.*
*.tfvars
secrets/

# Customer/staff uploads. Runtime templates and the generic fallback image stay versioned.
api/uploads/profile-pictures/
api/uploads/passports/
api/uploads/guest-documents/
api/uploads/tmp/

# Database copies, backups, exports, and generated financial/reporting output.
*.bson
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db
*.rdb
*.aof
*.csv
*.tsv
*.jsonl
*.ndjson
*.xlsx
*.xls
*.numbers
*.pdf
*.docx
*.pptx
*.har
backups/
*.archive.gz
*.archive.gz.enc
*.archive.gz.enc.part
exports/
output/
outputs/
local-data/

# Explicitly reviewed application templates/manuals required by the program.
!api/uploads/document-templates/*.xlsx
!api/uploads/document-templates/*.numbers
!docs/bookings-user-manual-th.docx

# Internal operational, security, and financial review documents.
docs/*-audit-*.md
docs/*-assessment-*.md
docs/*-report*.md
docs/*-runbook*.md
docs/*-plan*.md
docs/*-evidence*.md
docs/*-review*.md
docs/*-remediation*.md

# Dependencies, generated frontend artifacts, logs, and local tooling state.
node_modules/
frontend/dist/
frontend/dist-ssr/
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/
.cache/
*.local

# OS and editor metadata.
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

.agents