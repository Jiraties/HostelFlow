NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hostelflow
JWT_SECRET=replace-with-a-long-random-secret
CRYPTO_SECRET=replace-with-64-hex-characters
ALLOWED_ORIGINS=http://localhost:5173
# Required in production. Render's public edge is the one trusted hop in front of
# this web service; keep this at 1 unless the deployed network path is changed and verified.
TRUST_PROXY_HOPS=1
# Set explicitly in production if preview deployments need API access.
# ALLOWED_VERCEL_PREVIEW_PATTERN=^https://your-project-[a-z0-9-]+\.vercel\.app$

# Restore verification uses a separate, isolated database. Never set this to MONGO_URI.
# RESTORE_VERIFY_MONGO_URI=mongodb://127.0.0.1:27017/hostelflow_restore_verification
# RESTORE_VERIFY_ACKNOWLEDGE_ISOLATED=true

# One-time guarded booking-extension idempotency index migration.
# RUN_BOOKING_EXTENSION_INDEX_MIGRATION=true

# Reopen-final-cash-shift rollback switch. Enabled unless explicitly false.
# CASH_SHIFT_REOPEN_ENABLED=true
# One-time guarded combined status-correction and cash-shift-reopen migration.
# RUN_COORDINATED_CORRECTION_INDEX_MIGRATION=true
